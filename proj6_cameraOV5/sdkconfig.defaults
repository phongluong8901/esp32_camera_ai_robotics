# Kích hoạt tính năng ngoại vi SPIRAM trên ESP32-S3
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y

# Thiết lập chế độ Octal SPI (OPI) và xung nhịp 80MHz cho dòng N16R8
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Tự động khởi tạo PSRAM khi cấp nguồn
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# Cấu hình Flash 16MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Kích hoạt hỗ trợ Camera OV5640 trong thư viện esp32-camera
CONFIG_OV5640_SUPPORT=y
CONFIG_CAMERA_CORE0=y
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=32768

# Tăng tốc CPU lên 240MHz (Bắt buộc cho OV5640 để không bị NO-EOI)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240